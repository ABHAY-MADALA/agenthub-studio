OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
APP_BASE_URL=http://127.0.0.1:8010

# Google OAuth - one connection powers Gmail, Google Drive, and Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8010/auth/github/callback
GITHUB_SCOPES=read:user public_repo

# RAG Documents (all optional - sensible defaults in config.py)
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_CHUNK_SIZE_TOKENS=1000
# RAG_CHUNK_OVERLAP_TOKENS=150
# RAG_TOP_K=5
# RAG_USE_MMR=true
# RAG_MAX_FILE_SIZE_MB=25
